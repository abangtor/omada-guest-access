<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#08111f">
  <title>{{ title }}</title>
  {{ style_html }}
  <style>
    :root { color-scheme:dark; --accent:{{ accent }}; } * { box-sizing:border-box; }
    body { min-height:100vh; margin:0; padding:24px; display:grid; place-items:center; overflow-x:hidden; color:#edf4ff; background:#050a13; font:16px/1.55 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
    body::before,body::after { content:""; position:fixed; z-index:-2; width:52vmax; aspect-ratio:1; border-radius:45% 55% 54% 46% / 38% 47% 53% 62%; filter:blur(12px); pointer-events:none; }
    body::before { top:-29vmax; left:-21vmax; background:color-mix(in srgb,var(--accent) 43%,transparent); animation:orbit-one 20s ease-in-out infinite alternate; } body::after { right:-28vmax; bottom:-26vmax; background:color-mix(in srgb,var(--accent) 22%,#34308c); animation:orbit-two 24s ease-in-out infinite alternate; }
    .stars { position:fixed; inset:0; z-index:-1; opacity:.42; pointer-events:none; background-image:radial-gradient(circle at 15% 20%,white 0 1px,transparent 1.5px),radial-gradient(circle at 75% 38%,white 0 1px,transparent 1.5px),radial-gradient(circle at 40% 82%,white 0 .8px,transparent 1.3px); background-size:240px 220px,310px 290px,180px 160px; animation:stars 18s linear infinite; }
    .shell { width:min(100%,620px); }.brand { display:flex; align-items:center; gap:12px; margin:0 8px 16px; animation:rise .6s ease both; }.mark { display:grid; place-items:center; width:42px; height:42px; color:white; border-radius:14px; background:linear-gradient(135deg,var(--accent),#756cff); box-shadow:0 10px 26px color-mix(in srgb,var(--accent) 40%,transparent); }.mark svg { width:23px; height:23px; }.brand span { color:#b9cbe5; font-size:.82rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
    main { overflow:hidden; padding:clamp(24px,6vw,42px); border:1px solid rgba(190,215,245,.16); border-radius:28px; background:rgba(12,24,42,.84); box-shadow:0 28px 82px rgba(0,0,0,.48); backdrop-filter:blur(22px); animation:rise .75s .08s ease both; } h1 { margin:0; font-size:clamp(1.8rem,6vw,2.55rem); letter-spacing:-.045em; line-height:1.05; }.intro { margin:14px 0 28px; color:#b7c7dc; font-size:1.05rem; }.restored { display:flex; gap:8px; align-items:center; margin:0 0 22px; padding:11px 13px; border-radius:13px; background:rgba(29,122,84,.22); color:#bdf4d8; font-size:.9rem; }.restored::before { content:"✓"; font-weight:800; }
    form { display:grid; gap:16px; } form label { display:grid; gap:7px; color:#d5e2f2; font-size:.9rem; font-weight:700; } form input:not([type=checkbox]),form textarea { width:100%; padding:13px 14px; color:#f2f7ff; border:1px solid rgba(191,215,244,.2); border-radius:13px; outline:0; background:rgba(4,12,23,.55); font:inherit; transition:.18s ease; } form textarea { min-height:104px; resize:vertical; } form input:focus,form textarea:focus { border-color:var(--accent); box-shadow:0 0 0 4px color-mix(in srgb,var(--accent) 20%,transparent); background:rgba(4,12,23,.82); } form .consent { display:flex; align-items:flex-start; gap:9px; color:#b7c7dc; font-size:.84rem; font-weight:500; line-height:1.4; } form .consent input { accent-color:var(--accent); margin-top:3px; }
    button[type=submit] { width:100%; padding:14px 18px; cursor:pointer; color:white; border:0; border-radius:14px; background:linear-gradient(135deg,var(--accent),#756cff); box-shadow:0 10px 22px color-mix(in srgb,var(--accent) 36%,transparent); font:700 1rem inherit; transition:transform .18s ease,box-shadow .18s ease; } button[type=submit]:hover { transform:translateY(-2px); box-shadow:0 15px 30px color-mix(in srgb,var(--accent) 44%,transparent); } #forget-details { border:0; background:transparent; color:#a9bad0; cursor:pointer; font:.82rem inherit; text-decoration:underline; } #status { min-height:1.5em; margin:20px 0 0; color:#d5e2f2; font-weight:600; } details { margin:4px 0; padding:10px 12px; color:#bdcce0; border-radius:12px; background:rgba(114,145,182,.12); font-size:.87rem; } summary { cursor:pointer; color:#e0ebf9; font-weight:700; } footer { margin:18px 8px 0; color:#92a5bf; text-align:center; font-size:.78rem; }
    @keyframes orbit-one { to { transform:translate(24vw,14vh) rotate(32deg) scale(1.14); } } @keyframes orbit-two { to { transform:translate(-19vw,-12vh) rotate(-34deg) scale(.82); } } @keyframes stars { to { background-position:240px 220px,-310px 290px,180px -160px; } } @keyframes rise { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:none; } } @media (prefers-reduced-motion:reduce) { *,*::before,*::after { animation-duration:.01ms !important; animation-iteration-count:1 !important; } } @media (max-width:440px) { body { padding:14px; } main { border-radius:22px; } }
  </style>
</head>
<body>
  <div class="stars" aria-hidden="true"></div><div class="shell">
    <div class="brand" aria-label="Private network"><div class="mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M3 9a13 13 0 0 1 18 0M6 12a8.5 8.5 0 0 1 12 0M9.5 15.5a3.5 3.5 0 0 1 5 0M12 19h.01"/></svg></div><span>Private network</span></div>
    <main><h1>{{ title }}</h1><p class="intro">{{ message }}</p>{% if request_id %}<p class="restored">Restoring your access request</p>{% endif %}{{ form_html }}{{ status_html }}</main><footer>Secure internet access</footer>
  </div>{{ script_html }}
</body>
</html>
