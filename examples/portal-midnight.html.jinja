<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#08111f">
  <title>{{ title }}</title>
  {{ style_html }}
  <style>
    :root { color-scheme: dark; --accent: {{ accent }}; }
    * { box-sizing: border-box; }
    body { min-height: 100vh; margin: 0; overflow-x: hidden; color: #eaf2ff; background: #08111f; font: 16px/1.55 Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    .orb { position: fixed; width: 34rem; height: 34rem; border-radius: 50%; filter: blur(12px); opacity: .34; pointer-events: none; }
    .orb-a { top: -18rem; left: -14rem; background: var(--accent); } .orb-b { right: -20rem; bottom: -22rem; background: #5752ff; }
    .page { position: relative; width: min(100%, 760px); min-height: 100vh; margin: auto; padding: clamp(22px, 7vw, 72px) 22px 34px; display: grid; align-content: center; }
    .eyebrow { display: flex; align-items: center; gap: 10px; margin-bottom: 26px; color: #c4d5ed; font-size: .76rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
    .pulse { width: 10px; height: 10px; border-radius: 50%; background: #4df0ae; box-shadow: 0 0 0 6px rgba(77,240,174,.14); }
    .card { position: relative; isolation: isolate; overflow: hidden; border: 1px solid rgba(196,218,246,.16); border-radius: 30px; padding: clamp(26px, 6vw, 50px); background: linear-gradient(135deg, rgba(24,41,66,.91), rgba(10,20,36,.82)); box-shadow: 0 32px 100px rgba(0,0,0,.42); backdrop-filter: blur(22px); }
    .card::after { content: ""; position: absolute; z-index: -1; inset: 0; opacity: .48; background: linear-gradient(130deg, color-mix(in srgb, var(--accent) 28%, transparent), transparent 43%); }
    .icon { display: grid; place-items: center; width: 56px; height: 56px; margin-bottom: 24px; border-radius: 18px; color: white; background: linear-gradient(135deg, var(--accent), #756cff); box-shadow: 0 14px 34px color-mix(in srgb, var(--accent) 38%, transparent); }
    .icon svg { width: 28px; height: 28px; }
    .hero { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 20px; align-items: center; margin-bottom: 30px; }
    .hero .icon { margin: 0; }
    h1 { margin: 0; overflow-wrap: anywhere; font-size: clamp(2.1rem, 7vw, 3.45rem); letter-spacing: -.055em; line-height: 1.02; }
    .intro { max-width: 52ch; margin: 9px 0 0; color: #b6c6dd; font-size: 1.04rem; }
    .restored { display: flex; align-items: center; gap: 10px; margin: 0 0 22px; padding: 12px 14px; border: 1px solid rgba(77,240,174,.22); border-radius: 14px; color: #bdf7dc; background: rgba(19,125,83,.16); font-size: .9rem; }
    .restored::before { content: "✓"; display: grid; place-items: center; width: 21px; height: 21px; border-radius: 50%; background: #4df0ae; color: #082017; font-weight: 900; }
    form { display: grid; gap: 16px; } form label { display: grid; gap: 8px; color: #dbe8f8; font-size: .88rem; font-weight: 750; }
    form input:not([type=checkbox]), form textarea { width: 100%; border: 1px solid rgba(191,215,244,.2); border-radius: 14px; padding: 14px 15px; color: #f4f8ff; background: rgba(4,12,23,.47); font: inherit; outline: none; transition: border .18s, box-shadow .18s, background .18s; }
    form textarea { min-height: 112px; resize: vertical; } form input:focus, form textarea:focus { border-color: var(--accent); background: rgba(4,12,23,.72); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 24%, transparent); }
    form .consent { display: flex; gap: 10px; color: #b6c6dd; font-size: .85rem; font-weight: 500; } form .consent input { accent-color: var(--accent); margin-top: 4px; }
    button[type=submit] { width: 100%; border: 0; border-radius: 14px; padding: 15px 18px; cursor: pointer; color: white; background: linear-gradient(135deg, var(--accent), #756cff); box-shadow: 0 12px 28px color-mix(in srgb, var(--accent) 33%, transparent); font: 800 1rem inherit; letter-spacing: .01em; transition: transform .18s ease, filter .18s ease; }
    button[type=submit]:hover { filter: brightness(1.12); transform: translateY(-1px); } #forget-details { border: 0; padding: 0; color: #9bb1cd; background: transparent; cursor: pointer; font: .82rem inherit; text-decoration: underline; text-underline-offset: 3px; }
    #status { min-height: 1.5em; margin: 22px 0 0; color: #d4e4fb; font-weight: 650; } details { margin-top: 20px; padding: 13px 15px; border: 1px solid rgba(191,215,244,.12); border-radius: 14px; color: #aebfd7; background: rgba(4,12,23,.26); font-size: .85rem; } summary { cursor: pointer; color: #e3edfb; font-weight: 750; }
    .footer { margin-top: 20px; color: #7990af; font-size: .78rem; text-align: center; } @media (max-width: 440px) { .page { padding-inline: 14px; } .card { border-radius: 23px; } .hero { gap: 16px; } }
  </style>
</head>
<body>
  <div class="orb orb-a"></div><div class="orb orb-b"></div>
  <div class="page">
    <div class="eyebrow"><span class="pulse"></span> Private network</div>
    <main class="card">
      <div class="hero">
        <div class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M2.5 9.5a14 14 0 0 1 19 0M6 13a9 9 0 0 1 12 0M9.5 16.5a4 4 0 0 1 5 0M12 20h.01"/><path d="M12 5v.01"/></svg></div>
        <div><h1>{{ title }}</h1><p class="intro">{{ message }}</p></div>
      </div>
      {% if request_id %}<p class="restored">Your previous request is still active.</p>{% endif %}
      {{ form_html }}
      {{ status_html }}
    </main>
    <p class="footer">Protected internet access · Please use responsibly</p>
  </div>
  {{ script_html }}
</body>
</html>
