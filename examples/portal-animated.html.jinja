<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="{{ accent }}">
  <title>{{ title }}</title>
  {{ style_html }}
  <style>
    :root { color-scheme:light; --accent:{{ accent }}; } * { box-sizing:border-box; }
    body { min-height:100vh; margin:0; padding:24px; display:grid; place-items:center; overflow-x:hidden; color:#12233f; background:#eef4fc; font:16px/1.55 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
    body::before,body::after { content:""; position:fixed; z-index:-2; width:48vmax; aspect-ratio:1; border-radius:42% 58% 61% 39% / 42% 42% 58% 58%; filter:blur(3px); pointer-events:none; }
    body::before { top:-22vmax; left:-18vmax; background:color-mix(in srgb,var(--accent) 40%,transparent); animation:drift-a 18s ease-in-out infinite alternate; }
    body::after { right:-24vmax; bottom:-28vmax; background:color-mix(in srgb,var(--accent) 23%,#82baff); animation:drift-b 22s ease-in-out infinite alternate; }
    .halo { position:fixed; z-index:-1; width:34vmax; aspect-ratio:1; border-radius:50%; background:color-mix(in srgb,var(--accent) 18%,transparent); filter:blur(34px); animation:pulse 10s ease-in-out infinite; pointer-events:none; }
    .shell { width:min(100%,620px); margin-inline:auto; }.brand { display:flex; align-items:center; gap:12px; margin:0 8px 16px; animation:rise .6s ease both; }
    .mark { display:grid; place-items:center; width:42px; height:42px; color:white; border-radius:14px; background:var(--accent); box-shadow:0 10px 26px color-mix(in srgb,var(--accent) 38%,transparent); }.mark svg { width:23px; height:23px; }.brand span { color:#60718e; font-size:.82rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
    main { overflow:hidden; padding:clamp(24px,6vw,42px); border:1px solid rgba(255,255,255,.78); border-radius:28px; background:rgba(255,255,255,.82); box-shadow:0 28px 80px rgba(28,54,95,.2); backdrop-filter:blur(20px); animation:rise .75s .08s ease both; }
    h1 { margin:0; font-size:clamp(1.8rem,6vw,2.55rem); letter-spacing:-.045em; line-height:1.05; }.intro { margin:14px 0 28px; color:#53627c; font-size:1.05rem; }.restored { display:flex; gap:8px; align-items:center; margin:0 0 22px; padding:11px 13px; border-radius:13px; background:#edf8f3; color:#176342; font-size:.9rem; }.restored::before { content:"✓"; font-weight:800; }
    form { display:grid; gap:16px; } form label { display:grid; gap:7px; color:#33445f; font-size:.9rem; font-weight:700; } form input:not([type=checkbox]),form textarea { width:100%; padding:13px 14px; color:#12233f; border:1px solid #d9e1ed; border-radius:13px; outline:0; background:rgba(255,255,255,.7); font:inherit; transition:.18s ease; } form textarea { min-height:104px; resize:vertical; } form input:focus,form textarea:focus { border-color:var(--accent); box-shadow:0 0 0 4px color-mix(in srgb,var(--accent) 17%,transparent); background:white; } form .consent { display:flex; align-items:flex-start; gap:9px; font-size:.84rem; font-weight:500; line-height:1.4; } form .consent input { accent-color:var(--accent); margin-top:3px; }
    button[type=submit] { width:100%; padding:14px 18px; cursor:pointer; color:white; border:0; border-radius:14px; background:var(--accent); box-shadow:0 10px 22px color-mix(in srgb,var(--accent) 32%,transparent); font:700 1rem inherit; transition:transform .18s ease,box-shadow .18s ease; } button[type=submit]:hover { transform:translateY(-2px); box-shadow:0 15px 30px color-mix(in srgb,var(--accent) 40%,transparent); } #forget-details { border:0; background:transparent; color:#6c7a92; cursor:pointer; font:.82rem inherit; text-decoration:underline; } #status { min-height:1.5em; margin:20px 0 0; color:#40516c; font-weight:600; } details { margin:4px 0; padding:10px 12px; color:#52627b; border-radius:12px; background:#f4f7fb; font-size:.87rem; } summary { cursor:pointer; color:#2b3e5c; font-weight:700; } footer { margin:18px 8px 0; color:#718099; text-align:center; font-size:.78rem; }
    @keyframes drift-a { to { transform:translate(23vw,14vh) rotate(28deg) scale(1.16); } } @keyframes drift-b { to { transform:translate(-18vw,-12vh) rotate(-32deg) scale(.83); } } @keyframes pulse { 50% { transform:scale(1.28); opacity:.55; } } @keyframes rise { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:none; } } @media (prefers-reduced-motion:reduce) { *,*::before,*::after { animation-duration:.01ms !important; animation-iteration-count:1 !important; } } @media (max-width:440px) { body { padding:14px; } main { border-radius:22px; } }
  </style>
</head>
<body>
  <div class="halo" aria-hidden="true"></div><div class="shell">
    <div class="brand" aria-label="Private network"><div class="mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M3 9a13 13 0 0 1 18 0M6 12a8.5 8.5 0 0 1 12 0M9.5 15.5a3.5 3.5 0 0 1 5 0M12 19h.01"/></svg></div><span>Private network</span></div>
    <main><h1>{{ title }}</h1><p class="intro">{{ message }}</p>{% if request_id %}<p class="restored">Restoring your access request</p>{% endif %}{{ form_html }}{{ status_html }}</main><footer>Secure internet access</footer>
  </div>{{ script_html }}
</body>
</html>
